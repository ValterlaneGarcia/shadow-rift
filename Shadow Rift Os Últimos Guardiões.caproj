            <event-sheet>Event Sheet Mapa.xml</event-sheet>
        </event-folder>
    </event-folder>
    <global-instances>
        <global-instance type="Keyboard" uid="1" />
        <global-instance type="Mouse" uid="2" />
        <global-instance type="Gamepad" uid="3">
            <properties>
                <analog-deadzone>25</analog-deadzone>
            </properties>
