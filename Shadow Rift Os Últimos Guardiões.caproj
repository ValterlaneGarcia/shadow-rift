<?xml version="1.0" encoding="utf-8" ?>
<c2project>
    <name>Shadow Rift Os Últimos Guardiões</name>
    <description>Shadow Rift é um Top-Down RPG de combate fluido onde os jogadores assumem o papel de protetores de um ovo de Kirin , lutar contra as diversidades de ambiente e monstros que tentam capturar o ovo . O diferencial central é o sistema de Build e Craft: Os jogadores podem montar suas próprias árvores de poderes e craftar seus diversos itens .</description>
    <version>1.0.0.0</version>
    <author>Valterlane Garcia &amp; Kauã Pereira</author>
    <author-email></author-email>
    <author-website>http://</author-website>
    <app-id>com.valterlane&amp;Kaua.ShadowRift</app-id>
    <unique-id>2lz456t3pz1ix</unique-id>
    <saved-with-version>28000</saved-with-version>
    <used-plugins>
        <plugin author="Scirra" id="Button" version="1">Button</plugin>
        <plugin author="Scirra" id="Keyboard" version="1">Keyboard</plugin>
        <plugin author="Scirra" id="Mouse" version="1">Mouse</plugin>
        <plugin author="Scirra" id="Sprite" version="1">Sprite</plugin>
        <plugin author="Scirra" id="Text" version="1">Text</plugin>
        <plugin author="Scirra" id="gamepad" version="1">Gamepad</plugin>
    </used-plugins>
    <used-behaviors>
        <behavior author="Scirra" id="EightDir" version="1">8 Direction</behavior>
        <behavior author="Scirra" id="bound" version="1">Bound to layout</behavior>
    </used-behaviors>
    <used-effects />
    <configurations>
        <configuration exporter-descname="HTML5" exporter-id="html5" name="HTML5" />
    </configurations>
    <window-size>
        <width>1920</width>
        <height>1080</height>
    </window-size>
    <pixel-rounding>0</pixel-rounding>
    <preview-effects>1</preview-effects>
    <first-layout>Menu inicial</first-layout>
    <use-loader-layout>1</use-loader-layout>
    <configuration-settings>
        <prop name="Clear background">Yes</prop>
        <prop name="Downscaling">Medium quality</prop>
        <prop name="Enable WebGL">On</prop>
        <prop name="Fullscreen in browser">Scale outer</prop>
        <prop name="Fullscreen scaling">High quality</prop>
        <prop name="Loader style">Construct 2 splash</prop>
        <prop name="Orientations">Any</prop>
        <prop name="Pause on unfocus">No</prop>
        <prop name="Physics engine">Box2D asm.js</prop>
        <prop name="Preload sounds">Yes</prop>
        <prop name="Preview browser">NW.js</prop>
        <prop name="Sampling">Linear</prop>
        <prop name="Use high-DPI display">Yes</prop>
    </configuration-settings>
    <object-folder>
        <object-folder name="Object Types Sistema">
            <object-type name="Keyboard" sid="893469452400813">
                <plugin id="Keyboard" />
            </object-type>
            <object-type name="Mouse" sid="524474196202993">
                <plugin id="Mouse" />
            </object-type>
            <object-type name="Gamepad" sid="952978615556301">
                <plugin id="gamepad" />
            </object-type>
            <object-type name="DebugDeControle" sid="561949523212915">
                <plugin id="Text" />
            </object-type>
            <object-type name="DebugescolhendoPersonagem" sid="438451804565635">
                <plugin id="Button" />
            </object-type>
        </object-folder>
        <object-folder name="Object Types Hitboxes">
            <object-folder name="hitbox jogadores">
                <object-type name="hitbox_jogadores" sid="802264127222412">
                    <plugin id="Sprite" />
                    <instance-variables>
                        <instance-variable comment="Controle responsável para manegar as conexões dos controles" name="CONTROL_GAMEPAD" sid="468527223108212" type="number" />
                    </instance-variables>
                    <behaviors>
                        <behavior-type name="8Direction" sid="916068090854272">
                            <behavior id="EightDir" />
                        </behavior-type>
                        <behavior-type name="BoundToLayout" sid="412260848612269">
                            <behavior id="bound" />
                        </behavior-type>
                    </behaviors>
                    <animation-folder>
                        <animation framecount="1" loop="0" name="Default" pingpong="0" repeatcount="1" repeatto="0" sid="579093950450839" speed="5">
                            <frame duration="1" hotspotX="0.5" hotspotY="0.5" />
                        </animation>
                    </animation-folder>
                </object-type>
            </object-folder>
            <object-folder name="hitbox armas" />
            <object-folder name="hitbox inimigos" />
        </object-folder>
        <object-folder name="Object Types Sprit">
            <object-folder name="Jogadores" />
            <object-folder name="background" />
            <object-folder name="HUB" />
        </object-folder>
    </object-folder>
    <families />
    <layout-folder>
